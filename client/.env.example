# One shared frontend dynamically routes requests to an allowlisted backend.
# Keep VITE_API_BASE during the NNMC rollout; it is a backward-compatible
# fallback for VITE_NNMC_API_BASE.
VITE_API_BASE=http://localhost:1337
VITE_NNMC_API_BASE=http://localhost:1337
VITE_NNMC_STATUS=active

VITE_MEXEL_API_BASE=http://localhost:1346
VITE_MEXEL_STATUS=active

# Enable later when the isolated Umit backend, DB and bucket are ready.
VITE_UMIT_API_BASE=
VITE_UMIT_STATUS=planned

VITE_DEFAULT_ORGANIZATION_CODE=nnmc

# Optional scalable replacement for the variables above. Keep it on one line
# in Coolify. Supported statuses: active, planned, maintenance.
# VITE_ORGANIZATIONS_JSON=[{"code":"nnmc","name":"Национальный научный медицинский центр","shortName":"ННМЦ","apiBase":"https://api-nnmc.example.kz","status":"active","theme":"indigo"},{"code":"mexel","name":"ТОО Mexel Health","shortName":"Mexel Health","apiBase":"https://api-mexel.example.kz","status":"active","theme":"emerald"}]
