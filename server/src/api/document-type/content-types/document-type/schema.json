{
  "kind": "collectionType",
  "collectionName": "document_types",
  "info": {
    "singularName": "document-type",
    "pluralName": "document-types",
    "displayName": "Document Type",
    "description": "Виды документов"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "requiresEds": {
      "type": "boolean",
      "default": false
    },
    "defaultSignatureSequential": {
      "type": "boolean",
      "default": false
    },
    "signingDeadlineDays": {
      "type": "integer"
    },
    "mandatorySigners": {
      "type": "json"
    },
    "qrTemplate": {
      "type": "text"
    },
    "stampTemplate": {
      "type": "text"
    },
    "allowedDepartments": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::department.department"
    },
    "documents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::document.document",
      "mappedBy": "documentType"
    }
  }
}
